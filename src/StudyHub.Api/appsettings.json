{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "StudyHub",
    "Audience": "StudyHub",
    "Key": "",
    "ExpiryMinutes": 60
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "RateLimits": {
    "Enabled": true,
    "GeneralPerUser": 300,
    "GeneralPerIp": 1000,
    "LoginPerIp": 60,
    "WritesPerUser": 30,
    "PracticeStartsPerUser": 30,
    "LiveConnectionsPerIp": 300
  }
}
